# Gmail Account Configuration
GMAIL_ADDRESS=your-ai-agent@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Authorized Sender Whitelist (comma-separated emails allowed to interact with the bot)
ALLOWED_SENDERS=you@example.com

# AI Backend Engine: "antigravity" (default: uses local agy CLI + Pro subscription) or "gemini"
AI_BACKEND=antigravity
AGY_BIN_PATH=agy

# Skills Directory
SKILLS_DIR=skills

# --- Gemini Authentication (Only required if AI_BACKEND=gemini) ---
# Option A: Google AI Studio (API Key)
GEMINI_API_KEY=your-gemini-api-key

# Option B: Google Cloud Vertex AI
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GOOGLE_SEARCH=true

# Caching & Storage Configuration
DB_PATH=data/emails.db
ATTACHMENTS_DIR=data/attachments

# Optional Tuning
IDLE_TIMEOUT_MINUTES=29
POLL_INTERVAL_SECONDS=15
