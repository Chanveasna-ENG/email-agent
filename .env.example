# Gmail Account Configuration
GMAIL_ADDRESS=your-ai-agent@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Authorized Sender Whitelist (comma-separated emails allowed to interact with the bot)
ALLOWED_SENDERS=you@example.com

# --- Gemini Authentication Option A: Google AI Studio (API Key) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Gemini Authentication Option B: Google Cloud Vertex AI ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GEMINI_MODEL=gemini-2.5-flash

# Caching & Storage Configuration
DB_PATH=data/emails.db
ATTACHMENTS_DIR=data/attachments
PERSONAS_DIR=personas
ENABLE_GOOGLE_SEARCH=true

# Optional Configuration
SYSTEM_PROMPT_FILE=config/system_prompt.txt
IDLE_TIMEOUT_MINUTES=29
POLL_INTERVAL_SECONDS=15
